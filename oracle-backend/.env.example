# Oracle Configuration
# Copy this file to .env and fill in your Oracle credentials

# Oracle connection details (on-prem / standard 12.1+ server, thin mode)
ORACLE_USER=hypemotiv
ORACLE_PASSWORD=change_me
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=ORCL
ORACLE_CONNECTSTRING=localhost:1521/ORCL

# --- Oracle Cloud Autonomous Database (ATP / ADW) example ---
# Uncomment the lines below, download the wallet from the OCI console, unzip
# it to /opt/hypemotiv/wallet and replace the ORACLE_* values above.
# ORACLE_USER=HYPEMOTIV
# ORACLE_PASSWORD=<your ATP schema password>
# ORACLE_CONNECTSTRING=hypemotiv_low
# WALLET_LOCATION=/opt/hypemotiv/wallet
# TNS_ADMIN=/opt/hypemotiv/wallet

# Connection pool (used for all DB calls; direct fallback if pool creation fails)
# ORACLE_POOL_MIN=0
# ORACLE_POOL_MAX=10
# ORACLE_POOL_INCREMENT=1

# REST API
PORT=3000

# Schema prefix (optional)
SCHEMA_PREFIX=hypemotiv

# File uploads (Oracle BLOB primary, local uploads/ fallback)
# Maximum accepted upload/rip size in megabytes.
MAX_UPLOAD_MB=25

# Email delivery (nodemailer)
# Leave SMTP_HOST / SMTP_USER / SMTP_PASS empty to use demo mode:
# messages are appended to outbox.log and the API still returns success.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hypemotiv.local

# Optional: absolute path to the yt-dlp binary.
# If unset, "yt-dlp" is resolved from PATH.
# Install on macOS with: brew install yt-dlp
# On Ubuntu/VPS: sudo apt install yt-dlp  (or pip install -U yt-dlp)
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Optional public meme-sound deployment on Vercel (must be publicly accessible).
# Vercel Deployment Protection must be disabled, or set a bypass token below.
VERCEL_SOUNDS_URL=
VERCEL_BYPASS_TOKEN=
# Comma-separated extra audio hosts allowed through /api/sounds/proxy
AUDIO_PROXY_EXTRA_HOSTS=
# Set to true to allow ANY http(s) audio host through /api/sounds/proxy.
# Non-audio content types / extensions are still rejected and the response
# Content-Type is normalized by extension (mp3/wav/m4a/ogg/webm).
AUDIO_PROXY_ALLOW_ALL=false

# Media tooling (absolute binary paths are optional; PATH is used as fallback)
# YTDLP_PATH=/path/to/yt-dlp
# FFMPEG_PATH=/path/to/ffmpeg

# Roboflow toothbrush detection (/api/detect/toothbrush)
# Leave the key/model empty to disable: the endpoint returns HTTP 200 with
# { success: false, configured: false, detections: [] } so the app can fall back.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_VERSION=1
