# Oracle Configuration
# Copy this file to .env and fill in your Oracle credentials

# Oracle connection details
ORACLE_USER=hr
ORACLE_PASSWORD=hr
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=ORCL
ORACLE_CONNECTSTRING=localhost:1521/ORCL

# REST API
PORT=3000

# Schema prefix (optional)
SCHEMA_PREFIX=hypemotiv
