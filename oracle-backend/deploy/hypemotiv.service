[Unit]
Description=HypeMotiv Oracle Backend (Node.js / Express)
Documentation=https://github.com/your-org/hypemotiv
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/hypemotiv/oracle-backend
EnvironmentFile=/opt/hypemotiv/oracle-backend/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hypemotiv

[Install]
WantedBy=multi-user.target
